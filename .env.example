# Copie para .env.local e preencha. Sem as variáveis do Supabase, o app roda no
# modo de demonstração (dados de exemplo em .data/, sem login).

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Endereço público do app (links de e-mail, webhooks, redirecionamentos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Assistente (console.anthropic.com > API Keys) ---
# Sem a chave, a conversa usa o intérprete de regras (só para testes).
ANTHROPIC_API_KEY=

# --- Transcrição de áudio (console.groq.com > API Keys) ---
GROQ_API_KEY=

# --- WhatsApp ---
# Provedor: uazapi (agora) ou meta (WhatsApp Cloud API oficial, depois)
WHATSAPP_PROVIDER=uazapi
# UAZAPI: endereço do servidor, token da instância e um segredo seu para o webhook
UAZAPI_BASE_URL=
UAZAPI_INSTANCE_TOKEN=
UAZAPI_WEBHOOK_SECRET=
# Número do WhatsApp do assistente (só dígitos, com DDI), para o link wa.me
WHATSAPP_BOT_NUMBER=
# Meta Cloud API (quando migrar)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- Filas e agendamento (console.upstash.com > QStash) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Segredo das varreduras agendadas (Vercel Cron manda no cabeçalho Authorization)
CRON_SECRET=

# --- Web Push (gere com: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br

# --- Cobrança (Asaas: sandbox primeiro, produção só no /replica-deploy) ---
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token que você define no painel da Asaas ao criar o webhook
ASAAS_WEBHOOK_TOKEN=

# --- E-mail (resend.com) ---
RESEND_API_KEY=
# comprovante de cancelamento e chamados de suporte (os e-mails de login saem pelo SMTP no Supabase)
EMAIL_FROM="Cabeça Leve <ola@seudominio.com.br>"

# --- Suporte humano (F3) ---
# Para onde vão os avisos de chamado novo (e-mail e WhatsApp do time, com DDI: 5511999990000)
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
# Quem pode responder em /suporte/painel (e-mails das contas do time, separados por vírgula)
ADMIN_EMAILS=
