# Variáveis do stack no Portainer (Stacks > Add stack > Environment variables > Advanced mode:
# cole este arquivo preenchido). Nunca faça commit deste arquivo preenchido.

# --- Onde o app fica ---
DOMAIN=app.seudominio.com.br
IMAGE=ghcr.io/vozzyup/cabeca-leve:latest
# Swarm + Traefik: nome da rede externa do Traefik, entrypoint e resolvedor de certificado
TRAEFIK_NETWORK=network_public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencryptresolver
# Variante simples (sem Traefik): porta na VPS
APP_PORT=3000

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Assistente e áudio ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- WhatsApp ---
WHATSAPP_PROVIDER=uazapi
WHATSAPP_BOT_NUMBER=
UAZAPI_BASE_URL=
UAZAPI_INSTANCE_TOKEN=
UAZAPI_WEBHOOK_SECRET=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_TEMPLATE_LEMBRETE=
META_TEMPLATE_RESUMO=
META_TEMPLATE_AVISO=

# --- Push (npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br

# --- Cobrança (sandbox primeiro; produção: https://api.asaas.com/v3) ---
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- E-mail e suporte ---
RESEND_API_KEY=
EMAIL_FROM=Cabeça Leve <ola@seudominio.com.br>
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
ADMIN_EMAILS=

# --- Varredura de lembretes (gere com: openssl rand -hex 32) ---
CRON_SECRET=
